{
  "name": "@devdigest/mcp",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Local stdio MCP server exposing DevDigest (list agents, run a review, read findings/conventions) to Claude Code / Claude Desktop. Thin HTTP client of the local Fastify API — no DB, no GitHub, no filesystem, no secrets.",
  "bin": {
    "devdigest-mcp": "dist/index.js"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "inspect": "pnpm build && npx @modelcontextprotocol/inspector --config inspector.config.json"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
