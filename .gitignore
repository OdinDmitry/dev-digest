node_modules/
dist/
# agent-runner ships as a JS GitHub Action — its bundled dist/ MUST be committed
# (GitHub runs action.yml `main: dist/index.js` as-is, with no build step).
!agent-runner/dist/
!agent-runner/dist/**
build/
.next/
out/
coverage/
*.tsbuildinfo
.env
.env.local
.DS_Store
.idea/
.turbo/
.pnpm-store/
*.log
.devdigest/cache/
clones/
playwright-report/
test-results/
.claude/launch.json

# emdash worktree config (local)
.emdash.json

# pr-self-review gate state — local verdict for the current tree, never shared
.claude/.pr-self-review/

# skill-eval run output (iteration dirs, benchmark.json, grading.json, review.html) —
# regenerated per comparison run, not test data; the committed source is
# .claude/skills/<name>/evals/
.claude/skills/*-workspace/
